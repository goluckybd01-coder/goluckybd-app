{
  "name": "goluckybd",
  "version": "1.0.0",
  "private": true,
  "workspaces": ["packages/*", "apps/*"],
  "scripts": {
    "dev:web": "yarn workspace @goluckybd/web dev",
    "dev:mobile": "yarn workspace @goluckybd/mobile start",
    "build:web": "yarn workspace @goluckybd/web build",
    "build:tokens": "yarn workspace @goluckybd/design-tokens build",
    "db:migrate": "supabase db push",
    "db:seed": "supabase db seed",
    "db:reset": "supabase db reset",
    "lint": "yarn workspaces run lint",
    "clean": "yarn workspaces run clean"
  },
  "devDependencies": {
    "typescript": "^5.4.0",
    "prettier": "^3.2.0",
    "eslint": "^8.57.0"
  },
  "engines": { "node": ">=18.0.0" }
}
